	partition fact_monthly_incidents = m
		mode: import
		queryGroup: 'Monthly Incidents'
		source =
				let
				    Sample = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), {"plant_code", "reporting_month", "source_category", "classification", "code_group", "incident_count"}),
				    Source = if DataFolder = "" then Sample else Table.PromoteHeaders(Excel.Workbook(File.Contents(DataFolder & "/fact_monthly_incidents.xlsx"), null, true){[Item="sheet1", Kind="Sheet"]}[Data], [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Source, {{"plant_code", type text}, {"reporting_month", type datetime}, {"source_category", type text}, {"classification", type text}, {"code_group", type text}, {"incident_count", Int64.Type}}, "en-GB")
				in
				    Typed

