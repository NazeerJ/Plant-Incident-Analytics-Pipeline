	column 'Is Last 12 Months'
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 0140d954-a892-4c1c-9828-9ad84f9aa053
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Last 12 Months]

		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR ( DATE(2019, 1, 1), TODAY() ),
				
				    "Year", YEAR([Date]),
				    
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    
				    "Month Year", FORMAT([Date], "MMM-YY"),
				    "YearMonth Sort", YEAR([Date]) * 100 + MONTH([Date]),
				    
				    "Day", DAY([Date]),
				    
				    "Day of Week Number", WEEKDAY([Date], 2), -- Monday = 1
				    "Day Name", FORMAT([Date], "dddd"),
				    
				    "Is Weekend", IF(WEEKDAY([Date], 2) > 5, TRUE(), FALSE()),
				    
				    "Week Number", WEEKNUM([Date], 2),
				    
				    "Today's Date", TODAY(),
				
				    "Is Last 3 Months",
				        [Date] >= DATE(
				            YEAR(EDATE(TODAY(), -3)),
				            MONTH(EDATE(TODAY(), -3)),
				            1
				        )
				        && [Date] <= TODAY(),
				
				    "Is Last 6 Months",
				        [Date] >= DATE(
				            YEAR(EDATE(TODAY(), -6)),
				            MONTH(EDATE(TODAY(), -6)),
				            1
				        )
				        && [Date] <= TODAY(),
				
				    "Is Last 12 Months",
				        [Date] >= DATE(
				            YEAR(EDATE(TODAY(), -12)),
				            MONTH(EDATE(TODAY(), -12)),
				            1
				        )
				        && [Date] <= TODAY()
				)
				
				```

	annotation PBI_Id = c95a84a37f494f4e8f4862521291add5

